    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.17",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@types/jmespath": "^0.15.2",
    "archiver": "^7.0.1",
